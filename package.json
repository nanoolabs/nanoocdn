{
  "private": true,
  "name": "cloudflare-b2",
  "version": "2.1.3",
  "description": "Provide access to a private Backblaze B2 bucket via a Cloudflare Worker",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write '**/*.{js,json,md}'",
    "setup": "pnpm run setup-vars && pnpm run setup-cors",
    "setup-cors": "test -f cors.json || cp templates/cors.json.example cors.json",
    "setup-vars": "test -f .dev.vars || cp templates/dev.vars.example .dev.vars"
  },
  "author": "Pat Patterson <pat@backblaze.com>",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.8.3",
    "wrangler": "^4.95.0"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "aws4fetch": "^1.0.20"
  }
}
